    { "id": "e_faq_nms", "from": "faq_listen", "to": "product_kb", "kind": "intent", "intent": "nms" },
    { "id": "e_faq_agent", "from": "faq_listen", "to": "xfer_product", "kind": "intent", "intent": "agent" },
    { "id": "e_faq_menu", "from": "faq_listen", "to": "menu", "kind": "intent", "intent": "menu" },
    { "id": "e_faq_repair", "from": "faq_listen", "to": "xfer_product", "kind": "repair" },

    { "id": "e_kb_after", "from": "product_kb", "to": "after_faq", "kind": "next" },
    { "id": "e_kb_repair", "from": "product_kb", "to": "ask_product", "kind": "repair" },
