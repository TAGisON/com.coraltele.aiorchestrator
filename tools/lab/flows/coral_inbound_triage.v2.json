    { "id": "e_intent_knowledge", "from": "intent", "to": "ask_product", "kind": "intent", "intent": "knowledge" },
    { "id": "e_intent_tech", "from": "intent", "to": "tech_help", "kind": "intent", "intent": "technical" },
    { "id": "e_intent_support", "from": "intent", "to": "tech_help", "kind": "intent", "intent": "support" },
    { "id": "e_intent_sales", "from": "intent", "to": "xfer_sales", "kind": "intent", "intent": "sales" },
    { "id": "e_intent_enquiry", "from": "intent", "to": "xfer_sales", "kind": "intent", "intent": "enquiry" },
    { "id": "e_intent_agent", "from": "intent", "to": "xfer_product", "kind": "intent", "intent": "agent" },
