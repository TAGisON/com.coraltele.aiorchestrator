    { "id": "menu", "type": "Speak", "prompt_ref": "menu" },
    { "id": "intent", "type": "ListenChoice", "repair": { "max_retries": 2, "unclear_prompt_ref": "repair_intent" } },
    { "id": "ask_product", "type": "Speak", "prompt_ref": "ask_product" },
    { "id": "faq_listen", "type": "ListenChoice", "repair": { "max_retries": 2, "unclear_prompt_ref": "repair_faq" } },
    { "id": "product_kb", "type": "Inform", "binding_ref": "product-faq" },
    { "id": "after_faq", "type": "Speak", "prompt_ref": "after_faq" },
    { "id": "after_faq_choice", "type": "ListenChoice", "repair": { "max_retries": 2, "unclear_prompt_ref": "repair_after_faq" } },
    { "id": "tech_help", "type": "Speak", "prompt_ref": "tech_help" },
    { "id": "tech_outcome", "type": "ListenChoice", "repair": { "max_retries": 1, "unclear_prompt_ref": "repair_tech" } },
    { "id": "xfer_sales", "type": "Tool", "tool": "transfer", "matrix_intent": "sales", "prompt_ref": "closing_sales" },
    { "id": "xfer_support", "type": "Tool", "tool": "transfer", "matrix_intent": "support", "prompt_ref": "closing_support" },
    { "id": "xfer_product", "type": "Tool", "tool": "transfer", "matrix_intent": "product", "prompt_ref": "closing_product" },
    { "id": "hangup", "type": "Tool", "tool": "hangup", "prompt_ref": "closing_hangup" }
  ],
