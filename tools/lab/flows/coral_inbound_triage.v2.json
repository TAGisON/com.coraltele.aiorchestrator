    { "id": "e_after_product", "from": "after_faq_choice", "to": "ask_product", "kind": "intent", "intent": "product" },
    { "id": "e_after_kitne", "from": "after_faq_choice", "to": "ask_product", "kind": "intent", "intent": "kitne" },
    { "id": "e_after_agent", "from": "after_faq_choice", "to": "xfer_product", "kind": "intent", "intent": "agent" },
    { "id": "e_after_menu", "from": "after_faq_choice", "to": "menu", "kind": "intent", "intent": "menu" },
    { "id": "e_after_done", "from": "after_faq_choice", "to": "hangup", "kind": "intent", "intent": "done" },
    { "id": "e_after_bye", "from": "after_faq_choice", "to": "hangup", "kind": "intent", "intent": "bye" },
