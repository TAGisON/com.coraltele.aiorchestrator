    { "id": "e_faq_ivdx", "from": "faq_listen", "to": "product_kb", "kind": "intent", "intent": "ivdx" },
    { "id": "e_faq_ucs", "from": "faq_listen", "to": "product_kb", "kind": "intent", "intent": "ucs" },
