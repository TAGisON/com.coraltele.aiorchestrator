  "prompts": {
    "greeting": {
      "en-IN": "Welcome to Coral Telematics. Please say your language: English, Hindi, Bengali, Telugu, Marathi, Tamil, Gujarati, Kannada, or Punjabi.",
      "hi-IN": "कॉरल टेलीमैटिक्स में आपका स्वागत है। अपनी भाषा कहें: English, Hindi, Bengali, Telugu, Marathi, Tamil, Gujarati, Kannada, या Punjabi."
    },
    "repair_lang": {
      "en-IN": "Please say English, Hindi, Bengali, Telugu, Marathi, Tamil, Gujarati, Kannada, or Punjabi.",
      "hi-IN": "कृपया English, Hindi, Bengali, Telugu, Marathi, Tamil, Gujarati, Kannada, या Punjabi कहें।"
    },
    "menu": {
      "en-IN": "How can I help? Say product for product questions, technical or support for issues, sales for business enquiry, or agent to speak to a person.",
      "hi-IN": "मैं कैसे मदद करूँ? प्रोडक्ट सवाल के लिए product, तकनीकी समस्या के लिए technical या support, बिज़नेस के लिए sales, या व्यक्ति से बात के लिए agent कहें।"
    },
    "repair_intent": {
      "en-IN": "Please say product, technical, sales, or agent.",
      "hi-IN": "कृपया product, technical, sales, या agent कहें।"
    },
    "ask_product": {
      "en-IN": "Ask about a Coral product — for example IRIS IVDX, Coral UCS, Media Gateway, Call Center, Dispatcher Console, MCX, or NMS. Or say agent for product desk, or menu to go back.",
      "hi-IN": "कॉरल प्रोडक्ट के बारे में पूछें — जैसे IRIS IVDX, Coral UCS, Media Gateway, Call Center, Dispatcher, MCX, या NMS। एजेंट के लिए agent, मेनू के लिए menu कहें।"
    },
    "repair_faq": {
      "en-IN": "Please name a product like IRIS, UCS, gateway, call center, dispatcher, MCX, or NMS — or say agent or menu.",
      "hi-IN": "कृपया IRIS, UCS, gateway, call center, dispatcher, MCX, या NMS कहें — या agent या menu।"
    },
    "after_faq": {
      "en-IN": "Anything else? Say more for another product question, agent for product desk, menu for main menu, or done to end.",
      "hi-IN": "और कुछ? और प्रोडक्ट सवाल के लिए more या baaki, प्रोडक्ट डेस्क के लिए agent, मेनू के लिए menu, या समाप्त करने के लिए done कहें।"
    },
    "repair_after_faq": {
      "en-IN": "Please say more, baaki, agent, menu, or done.",
      "hi-IN": "कृपया more, baaki, agent, menu, या done कहें।"
    },
    "tech_help": {
      "en-IN": "Let's try a quick check. Confirm power and network, restart the device if you can, then say resolved if it is fixed, or unresolved if you still need support.",
      "hi-IN": "जल्दी जाँच करें। पावर और नेटवर्क देखें, संभव हो तो डिवाइस रीस्टार्ट करें। ठीक हो तो resolved, नहीं तो unresolved कहें।"
    },
    "repair_tech": {
      "en-IN": "Please say resolved or unresolved.",
      "hi-IN": "कृपया resolved या unresolved कहें।"
    },
    "closing_sales": {
      "en-IN": "Connecting you to the Sales department on 5005.",
      "hi-IN": "आपको सेल्स विभाग 5005 पर जोड़ रहे हैं।"
    },
    "closing_support": {
      "en-IN": "Connecting you to Technical Support on 5006.",
      "hi-IN": "आपको तकनीकी सहायता 5006 पर जोड़ रहे हैं।"
    },
    "closing_product": {
      "en-IN": "Connecting you to the Product desk on 5007.",
      "hi-IN": "आपको प्रोडक्ट डेस्क 5007 पर जोड़ रहे हैं।"
    },
    "closing_hangup": {
      "en-IN": "Thank you for calling Coral. Goodbye.",
      "hi-IN": "कॉरल को कॉल करने के लिए धन्यवाद। नमस्ते।"
    }
  },
  "matrix": [
