    { "id": "e_tech_unresolved", "from": "tech_outcome", "to": "xfer_support", "kind": "intent", "intent": "unresolved" },
    { "id": "e_tech_notfixed", "from": "tech_outcome", "to": "xfer_support", "kind": "intent", "intent": "not fixed" },
    { "id": "e_tech_agent", "from": "tech_outcome", "to": "xfer_support", "kind": "intent", "intent": "agent" },
    { "id": "e_tech_repair", "from": "tech_outcome", "to": "xfer_support", "kind": "repair" }
