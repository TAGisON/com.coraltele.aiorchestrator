# Environment template — local lab

Copy to `.env` (do not commit). Same pattern as Coral telemetry: shared Postgres on 127.0.0.1:5432, short DB name per service.

# Required for durable lab (create DB first: tools/lab/Init-LabDatabase.ps1)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/aiorchestrator?sslmode=disable
REQUIRE_DATABASE=1

HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json

# Optional Control Bearer (empty = open lab)
# CONTROL_AUTH_TOKEN=

# Sarvam (real STT/LLM/TTS) — never commit the key
# SARVAM_API_KEY=

# OWNER_INSTANCE=local
# EDGE_TOKEN_SECRET=lab-edge-hmac-change-me
# CORAL_BASE_URL=
